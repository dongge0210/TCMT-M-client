<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- 不传 -r 时默认按宿主 RID 构建。只写 RuntimeIdentifiers（复数）而留空 RuntimeIdentifier，
         SDK 会走 RID 无关构建：NuGet 把每个包所有 RID 的原生资产都摊进 runtimes/，
         Debug 产物因此到过 783MB（17 个 RID，单 Windows x64 的 SkiaSharp.pdb 就 80MB）。
         交叉构建仍然显式传 -r，不受这条默认值影响。 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <!-- Program.cs 靠这三个常量选后端，和下面按宿主引入的 Avalonia 后端包一一对应。 -->
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('osx'))">$(DefineConstants);TCMT_MACOS</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('windows'))">$(DefineConstants);TCMT_WINDOWS</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('linux'))">$(DefineConstants);TCMT_LINUX</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyTitle>TCMT - 系统硬件监视器</AssemblyTitle>
    <AssemblyDescription>实时硬件监控工具 Avalonia 版本</AssemblyDescription>
    <!-- 只能填数字，不能带 ALPHA_ 前缀 —— 跟根 CMakeLists 的 project(VERSION) 对齐。
         改版本时六处一起改，清单见 AvaloniaUI/Core/Constants.cs 上面那段注释。 -->
    <AssemblyVersion>0.0.79.0</AssemblyVersion>
    <RootNamespace>TCMT.Avalonia</RootNamespace>
    <!-- OS support: Windows 10 22H2+ / Win11 24H2+, macOS 15+ (arm64 + Intel), Ubuntu 22.04 LTS+ -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('osx'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('windows'))">10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- _archive/ 是已并进概览的旧五屏(CPU/GPU/内存/存储/温度)。_archive/README.md 声称
       「不参与构建」,但 SDK 式工程默认通配把它们连同 .axaml 一起编了进来。
       StorageViewModel 引用的 Letter / LogicalDriveLetters 正要改成挂载点,归档不该跟着改。
       .axaml 与 .cs 必须成对排除 —— 只排一半会留下没有 code-behind 的 XAML,编译失败。 -->
  <ItemGroup>
    <Compile Remove="_archive\**\*.cs" />
    <AvaloniaXaml Remove="_archive\**\*.axaml" />
    <AvaloniaResource Remove="_archive\**\*.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <!-- 不用 Avalonia.Desktop：这个元包无条件依赖 Win32、X11、FreeDesktop、Native 四套后端，
         每个平台的产物里都混着另外两套（macOS 的 Release 里就有 Avalonia.Win32/X11/FreeDesktop
         和 Tmds.DBus.Protocol）。按宿主只引一个后端；两个渲染包是 Desktop 原本替我们引的。
         Program.cs 的 UseHarfBuzz/UseSkia 与这里的包一一对应，删包必须同时删调用。 -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.1" />
    <PackageReference Include="Avalonia.Native" Version="12.1.1" Condition="$([MSBuild]::IsOSPlatform('osx'))" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.1" Condition="$([MSBuild]::IsOSPlatform('windows'))" />
    <PackageReference Include="Avalonia.X11" Version="12.1.1" Condition="$([MSBuild]::IsOSPlatform('linux'))" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
