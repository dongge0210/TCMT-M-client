<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TCMT.Avalonia.ViewModels"
             xmlns:models="clr-namespace:TCMT.Avalonia.Models"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="TCMT.Avalonia.Views.NetworkView"
             x:DataType="vm:NetworkViewModel">

  <Design.DataContext>
    <vm:NetworkViewModel Title="网络" />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*">
    <!-- TopBar matching pen design -->
    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="14,20">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="网络" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding Adapters.Count, StringFormat='{}{0} 适配器'}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
          <TextBlock Text="Updated 2s ago" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content matching pen design -->
    <ScrollViewer Grid.Row="1" Background="{StaticResource BackgroundBrush}" Padding="20">
      <StackPanel Spacing="16">

        <!-- AdapterCard -->
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
          <StackPanel Spacing="8">
            <!-- AdapterHeader -->
            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
              <Run Text="{Binding SelectedAdapter.Name}"/><Run Text=" · "/><Run Text="{Binding SelectedAdapter.AdapterType}"/>
            </TextBlock>
            <Rectangle Height="1" Fill="{StaticResource BorderBrush}"/>

            <!-- IP Row -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="IP" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="1" Text="{Binding SelectedAdapter.IpAddress}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Normal"/>
            </Grid>

            <!-- MAC Row -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="MAC" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="1" Text="{Binding SelectedAdapter.Mac}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- WiFi rows (only when WiFi is available) -->
            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" IsVisible="{Binding HasWiFi}"/>

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasWiFi}">
              <TextBlock Text="SSID" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="1" Text="{Binding WifiSSID}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasWiFi}">
              <TextBlock Text="频道" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="1" Text="{Binding WifiChannel}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasWiFi}">
              <TextBlock Text="RSSI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="1">
                <TextBlock Text="{Binding WifiRSSI, StringFormat='{}{0} dBm'}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
              </TextBlock>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasWiFi}">
              <TextBlock Text="频段" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="1" Text="{Binding WifiBand}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasWiFi}">
              <TextBlock Text="协议" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="1" Text="{Binding WifiGen}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasWiFi}">
              <TextBlock Text="链接速度" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="1" Text="{Binding SelectedAdapter.SpeedDisplay}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>

            <!-- State guidance: says what to do next, in words rather than colour -->
            <TextBlock Text="{Binding WifiStateNote}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}"
                       IsVisible="{Binding HasWifiNote}"/>

            <!-- Missing capability never blanks the section: keep the slot, say why, stay muted
                 (TUI design #10 — show what has a handler, never fake the rest). -->
            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" IsVisible="{Binding HasNoWiFi}"/>
            <TextBlock Text="未检测到无线网卡——无线信息不可读"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}"
                       IsVisible="{Binding HasNoWiFi}"/>
          </StackPanel>
        </Border>

        <!-- TrafficRow matching pen design -->
        <Grid ColumnDefinitions="*,*" Grid.ColumnSpan="2">
          <!-- Download Card -->
          <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock Text="下载" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
              <!-- ↓ blue / ↑ green, the same pairing the overview chart uses -->
              <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}">
                <Run Text="↓ "/><Run Text="{Binding SelectedAdapter.DownloadDisplay}"/>
              </TextBlock>
            </StackPanel>
          </Border>
          <!-- Upload Card -->
          <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="12,0,0,0">
            <StackPanel Spacing="4">
              <TextBlock Text="上传" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                <Run Text="↑ "/><Run Text="{Binding SelectedAdapter.UploadDisplay}"/>
              </TextBlock>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Interfaces: one row per adapter, columns per the design draft.
             These rows are read-only, so they carry no click affordance. -->
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Text="Interfaces" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
              <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}">
                <Run Text="{Binding Adapters.Count}"/><Run Text=" 个接口"/>
              </TextBlock>
            </Grid>
            <Rectangle Height="1" Fill="{StaticResource BorderBrush}"/>

            <Grid ColumnDefinitions="*,100,140,170,86,86">
              <TextBlock Grid.Column="0" Text="接口" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
              <TextBlock Grid.Column="1" Text="类型" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
              <TextBlock Grid.Column="2" Text="IPv4" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
              <TextBlock Grid.Column="3" Text="MAC" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
              <TextBlock Grid.Column="4" Text="↓" FontSize="10" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}"/>
              <TextBlock Grid.Column="5" Text="↑" FontSize="10" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Adapters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:NetworkAdapterData">
                  <Grid ColumnDefinitions="*,100,140,170,86,86" Height="26">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding AdapterType}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding IpAddress}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding Mac}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding DownloadDisplay}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryBrush}"/>
                    <TextBlock Grid.Column="5" Text="{Binding UploadDisplay}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryBrush}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state, in the design draft's own words -->
            <TextBlock Text="no interfaces" IsVisible="{Binding HasNoAdapters}"
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>