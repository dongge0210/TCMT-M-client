<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TCMT.Avalonia.ViewModels"
             xmlns:themes="clr-namespace:TCMT.Avalonia.Themes"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="TCMT.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <Design.DataContext>
    <vm:SettingsViewModel Title="Settings" />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="32,28,32,0">
      <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBlock Text="应用设置" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Content -->
    <ScrollViewer Grid.Row="1" Margin="32,20,32,32">
      <StackPanel Spacing="20">
        
        <!-- Appearance -->
        <Border Theme="{StaticResource CardBorder}">
          <StackPanel Spacing="16">
            <TextBlock Text="外观" Theme="{StaticResource SectionHeader}"/>
            
            <StackPanel Spacing="8">
              <TextBlock Text="主题" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
              <ComboBox SelectedItem="{Binding CurrentTheme}" Width="200">
                <ComboBox.Items>
                  <themes:AppTheme>Dark</themes:AppTheme>
                  <themes:AppTheme>Light</themes:AppTheme>
                </ComboBox.Items>
              </ComboBox>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Font -->
        <Border Theme="{StaticResource CardBorder}">
          <StackPanel Spacing="16">
            <TextBlock Text="字体" Theme="{StaticResource SectionHeader}"/>

            <StackPanel Spacing="8">
              <TextBlock Text="系统字体" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
              <ComboBox ItemsSource="{Binding SystemFonts}"
                        SelectedItem="{Binding SelectedFontFamily}"
                        Width="280">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="13"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="字号" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
              <NumericUpDown Value="{Binding FontSize}" Minimum="8" Maximum="32" Width="100"/>
            </StackPanel>

            <!-- Native font dialog (Windows only) -->
            <Button Content="系统字体面板…"
                    Command="{Binding PickSystemFontCommand}"
                    IsVisible="{Binding IsNativeFontDialogSupported}"
                    Width="160"
                    HorizontalAlignment="Left"/>

            <!-- Preview -->
            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="6" Padding="12">
              <TextBlock Text="{Binding FontPreviewText}"
                         FontFamily="{Binding SelectedFontFamily}"
                         FontSize="{Binding FontSize}"
                         Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>
          </StackPanel>
        </Border>

        <!--
          采集端：这几项不属于客户端 —— 它们落在采集端的 system_monitor.json 里，
          和 TUI 按 S 打开的是同一份。两个界面改的是同一个东西，不是各存一份。
        -->
        <Border Theme="{StaticResource CardBorder}">
          <StackPanel Spacing="16">
            <TextBlock Text="采集端" Theme="{StaticResource SectionHeader}"/>

            <StackPanel Spacing="12" IsEnabled="{Binding CollectorEditable}">

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="数据上传" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CollectorUploadEnabled}"
                              OnContent="开" OffContent="关"/>
              </Grid>

              <StackPanel Spacing="6">
                <TextBlock Text="服务器地址" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding CollectorUrl}" Width="360" HorizontalAlignment="Left"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="跳过 TLS 校验" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CollectorInsecure}"
                              OnContent="开" OffContent="关"/>
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="上传间隔（秒）" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="1" Value="{Binding CollectorIntervalSec}"
                               Minimum="1" Maximum="60" Width="120"/>
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="采样间隔（毫秒）" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="1" Value="{Binding CollectorSampleIntervalMs}"
                               Minimum="200" Maximum="5000" Increment="100" Width="120"/>
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="语言" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding CollectorLanguage}" Width="140"/>
              </Grid>

            </StackPanel>

            <TextBlock Text="只发改动的那一项，采集端应用后回推一份新值。"
                       IsVisible="{Binding CollectorEditable}"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="未连接采集端 —— 这一组现在改不了，值会在连上后自动填进来。"
                       IsVisible="{Binding !CollectorEditable}"
                       TextWrapping="Wrap"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
          </StackPanel>
        </Border>

        <!-- About -->
        <Border Theme="{StaticResource CardBorder}">
          <StackPanel Spacing="12">
            <TextBlock Text="关于" Theme="{StaticResource SectionHeader}"/>
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="应用" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="TCMT — 系统硬件监视器" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="版本" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>